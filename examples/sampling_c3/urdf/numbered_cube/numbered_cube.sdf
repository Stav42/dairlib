<?xml version="1.0"?>
<sdf version="1.7">
  <model name="numbered_cube">
    <link name="numbered_cube">
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.2</mass>
        <inertia>
          <ixx>0.00012</ixx>
          <iyy>0.00012</iyy>
          <izz>0.00012</izz>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
        </inertia>
      </inertial>

      <!-- Face 1: Red (+X) -->
      <visual name="face_1_red">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>meshes/face_1_red.obj</uri>
          </mesh>
        </geometry>
      </visual>

      <!-- Face 2: Blue (-X) -->
      <visual name="face_2_blue">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>meshes/face_2_blue.obj</uri>
          </mesh>
        </geometry>
      </visual>

      <!-- Face 3: Green (+Y) -->
      <visual name="face_3_green">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>meshes/face_3_green.obj</uri>
          </mesh>
        </geometry>
      </visual>

      <!-- Face 4: Yellow (-Y) -->
      <visual name="face_4_yellow">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>meshes/face_4_yellow.obj</uri>
          </mesh>
        </geometry>
      </visual>

      <!-- Face 5: Orange (+Z) -->
      <visual name="face_5_orange">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>meshes/face_5_orange.obj</uri>
          </mesh>
        </geometry>
      </visual>

      <!-- Face 6: Purple (-Z) -->
      <visual name="face_6_purple">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>meshes/face_6_purple.obj</uri>
          </mesh>
        </geometry>
      </visual>

      <!-- Single box collision for the whole cube -->
      <collision name="cube_collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.06 0.06 0.06</size>
          </box>
        </geometry>
        <drake:proximity_properties>
          <drake:mu_static>0.8</drake:mu_static>
          <drake:mu_dynamic>0.5</drake:mu_dynamic>
        </drake:proximity_properties>
      </collision>
    </link>
  </model>
</sdf>
