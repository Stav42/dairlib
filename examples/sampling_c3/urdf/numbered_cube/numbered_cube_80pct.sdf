<?xml version="1.0"?>
<sdf version="1.7">
  <!-- A 0.8x linear copy of numbered_cube.sdf.  The mass (s^3) and the
       diagonal inertia (s^5) preserve the parent cube's material density. -->
  <model name="numbered_cube">
    <link name="numbered_cube">
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.0256</mass>
        <inertia>
          <ixx>0.0000098304</ixx>
          <iyy>0.0000098304</iyy>
          <izz>0.0000098304</izz>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
        </inertia>
      </inertial>

      <!-- The original colored and numbered mesh faces, uniformly scaled. -->
      <visual name="face_1_red">
        <pose>0 0 0 0 0 0</pose>
        <geometry><mesh><uri>meshes/face_1_red.obj</uri><scale>0.8 0.8 0.8</scale></mesh></geometry>
      </visual>
      <visual name="face_2_blue">
        <pose>0 0 0 0 0 0</pose>
        <geometry><mesh><uri>meshes/face_2_blue.obj</uri><scale>0.8 0.8 0.8</scale></mesh></geometry>
      </visual>
      <visual name="face_3_green">
        <pose>0 0 0 0 0 0</pose>
        <geometry><mesh><uri>meshes/face_3_green.obj</uri><scale>0.8 0.8 0.8</scale></mesh></geometry>
      </visual>
      <visual name="face_4_yellow">
        <pose>0 0 0 0 0 0</pose>
        <geometry><mesh><uri>meshes/face_4_yellow.obj</uri><scale>0.8 0.8 0.8</scale></mesh></geometry>
      </visual>
      <visual name="face_5_orange">
        <pose>0 0 0 0 0 0</pose>
        <geometry><mesh><uri>meshes/face_5_orange.obj</uri><scale>0.8 0.8 0.8</scale></mesh></geometry>
      </visual>
      <visual name="face_6_purple">
        <pose>0 0 0 0 0 0</pose>
        <geometry><mesh><uri>meshes/face_6_purple.obj</uri><scale>0.8 0.8 0.8</scale></mesh></geometry>
      </visual>

      <collision name="cube_collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry><box><size>0.048 0.048 0.048</size></box></geometry>
        <drake:proximity_properties>
          <drake:mu_static>0.8</drake:mu_static>
          <drake:mu_dynamic>0.5</drake:mu_dynamic>
        </drake:proximity_properties>
      </collision>
    </link>
  </model>
</sdf>
